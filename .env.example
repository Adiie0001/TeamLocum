# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# The first administrator, created once when the database has no administrator. Both are required.
# Password: 10+ characters with upper case, lower case, a digit and at least 4 different characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IANA time zone in which shift times are entered and "now" is judged.
CLINIC_TIME_ZONE=Europe/London

# Optional AI ranking of doctors. Leave it off to keep everything on the rule-based matcher.
GEMINI_ENABLED=false
GEMINI_API_KEY=
