@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@if (Model.Actor is { } actor)
{
    <section class="mb-4">
        <h1 class="h3">Welcome back</h1>
        <p class="text-muted">
            @if (actor.IsAdmin) { <text>You are signed in as an administrator: approve hospitals and doctors, and oversee every shift.</text> }
            else if (actor.IsClient) { <text>You are signed in as a hospital or clinic: post shifts, review applicants and fill them.</text> }
            else { <text>You are signed in as a locum doctor: find open shifts and apply for the ones that suit you.</text> }
        </p>

        <div class="row row-cols-1 row-cols-md-4 g-3 mb-3">
            @foreach (var item in Model.Items)
            {
                <div class="col">
                    <a class="card h-100 text-decoration-none" asp-controller="@item.Controller" asp-action="@item.Action">
                        <div class="card-body">
                            <div class="display-6">@item.Value</div>
                            <div class="text-muted">@item.Label</div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (actor.CanPostShifts)
            {
                <a class="btn btn-primary" asp-controller="Bookings" asp-action="Create">Post a shift</a>
            }
            @if (actor.IsLocum)
            {
                <a class="btn btn-primary" asp-controller="Bookings" asp-action="Index" asp-route-scope="Open">Browse open shifts</a>
                <a class="btn btn-outline-primary" asp-controller="Locums" asp-action="Profile">Update my profile</a>
            }
            @if (actor.IsClient)
            {
                <a class="btn btn-outline-primary" asp-controller="Locums" asp-action="Index">Find doctors</a>
            }
            @if (actor.IsAdmin)
            {
                <a class="btn btn-outline-primary" asp-controller="Clients" asp-action="Index" asp-route-status="AwaitingReview">Review hospitals</a>
                <a class="btn btn-outline-primary" asp-controller="Locums" asp-action="Index" asp-route-status="PendingReview">Review doctors</a>
            }
        </div>
    </section>
}
else
{
    <section class="py-5 text-center">
        <h1 class="display-5 fw-bold">TeamLocum</h1>
        <p class="lead col-lg-7 mx-auto">
            A staffing platform that connects locum doctors with hospitals and clinics. Hospitals post shifts, approved doctors
            apply, and the platform makes sure no doctor is ever booked into two overlapping shifts.
        </p>
        <p>
            <a class="btn btn-primary btn-lg me-2" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
            <a class="btn btn-outline-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        </p>
    </section>

    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Hospitals and clinics</h2>
                    <p class="text-muted mb-0">Post a shift with its specialty, location and rate. Review applicants ranked by a transparent score and fill the shift in one step.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Locum doctors</h2>
                    <p class="text-muted mb-0">Keep one profile with your specialties, base and minimum rate. Apply for open shifts; clashes with shifts you already hold are refused.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Vetted accounts</h2>
                    <p class="text-muted mb-0">Every hospital and doctor is approved by an administrator before they can post or work shifts. Each role sees only its own data.</p>
                </div>
            </div>
        </div>
    </div>
}
