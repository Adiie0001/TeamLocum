@model IReadOnlyList<DashboardItem>
@{
    ViewData["Title"] = "Administration";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Administration</h1>
    <a class="btn btn-outline-primary" asp-action="Users">Accounts</a>
</div>

<div class="row row-cols-1 row-cols-md-4 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <a class="card h-100 text-decoration-none" asp-controller="@item.Controller" asp-action="@item.Action">
                <div class="card-body">
                    <div class="display-6">@item.Value</div>
                    <div class="text-muted">@item.Label</div>
                </div>
            </a>
        </div>
    }
</div>
