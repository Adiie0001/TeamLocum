@model IReadOnlyList<UserRow>
@{
    ViewData["Title"] = "Accounts";
}

<h1 class="h3 mb-3">Accounts</h1>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>@user.Roles</td>
                    <td>
                        @if (user.LockedOut)
                        {
                            <span class="badge text-bg-danger">Locked out</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (user.LockedOut)
                        {
                            <form asp-action="Unlock" asp-route-id="@user.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Unlock</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
