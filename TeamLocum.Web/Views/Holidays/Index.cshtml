@model IReadOnlyList<Holiday>
@{
    ViewData["Title"] = "Bank holidays";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bank holidays</h1>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">Add a bank holiday</a>
    }
</div>
<p class="text-muted">Shifts that fall on these dates are flagged so hospitals and doctors can agree premium rates. They are never blocked.</p>

@if (Model.Count == 0)
{
    <p class="text-muted">No bank holidays are listed.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Date</th><th>Holiday</th><th></th></tr></thead>
        <tbody>
            @foreach (var holiday in Model)
            {
                <tr>
                    <td>@UiHelpers.Date(holiday.Date)</td>
                    <td>@holiday.Details</td>
                    <td class="text-end">
                        @if (isAdmin)
                        {
                            <form asp-action="Delete" asp-route-id="@holiday.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
