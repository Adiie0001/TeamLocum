@inject IActorAccessor Actors
@{
    var actor = await Actors.GetAsync();
    var signedIn = User.Identity?.IsAuthenticated == true;
    string? pending = null;
    if (actor is { IsClient: true, ClientStatus: { } clientStatus } && clientStatus != ClientStatus.Accepted)
    {
        pending = $"Your hospital account is {UiHelpers.Label(clientStatus).ToLowerInvariant()}. You can post shifts once an administrator approves it.";
    }
    else if (actor is { IsLocum: true, LocumStatus: { } locumStatus } && locumStatus != LocumStatus.Active)
    {
        pending = $"Your doctor profile is {UiHelpers.Label(locumStatus).ToLowerInvariant()}. You can apply for shifts once an administrator approves it.";
    }
}
<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TeamLocum</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index">TeamLocum</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                        aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto">
                        @if (signedIn && actor is not null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Bookings" asp-action="Index">@(actor.IsLocum ? "Shifts" : "Bookings")</a></li>
                            @if (actor.IsAdmin || actor.IsClient)
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Locums" asp-action="Index">Doctors</a></li>
                            }
                            @if (actor.IsAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Clients" asp-action="Index">Hospitals</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users">Accounts</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Holidays" asp-action="Index">Bank holidays</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center">
                        @if (signedIn)
                        {
                            @if (actor is { IsClient: true })
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Clients" asp-action="Profile">My hospital</a></li>
                            }
                            else if (actor is { IsLocum: true })
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Locums" asp-action="Profile">My profile</a></li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    @User.Identity!.Name
                                    @if (actor is not null) { <span class="badge text-bg-secondary ms-1">@actor.Role</span> }
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (pending is not null)
        {
            <div class="alert alert-warning" role="status">@pending</div>
        }
        <partial name="_Flash" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3">
        <div class="container text-center">
            TeamLocum · Healthcare staffing platform · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
