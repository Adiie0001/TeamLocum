@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="py-5 text-center">
    <p class="display-1 text-muted">@Model.Status</p>
    <h1 class="h3">@Model.Title</h1>
    <p class="text-muted">
        @if (Model.Status == 404)
        {
            <text>The page may have moved, or it may belong to somebody else's account.</text>
        }
        else if (Model.Status == 403)
        {
            <text>Your account does not have permission for this page.</text>
        }
        else
        {
            <text>If this keeps happening, quote the reference below when you contact support.</text>
        }
    </p>
    <p><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to the home page</a></p>
    <p class="small text-muted">Reference: <code>@(Model.CorrelationId ?? Model.RequestId)</code></p>
</div>
