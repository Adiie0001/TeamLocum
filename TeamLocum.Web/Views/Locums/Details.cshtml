@model LocumDetailsViewModel
@{
    var locum = Model.Locum;
    ViewData["Title"] = locum.Name;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@locum.Name</h1>
        <span class="badge @UiHelpers.Badge(locum.Status)">@UiHelpers.Label(locum.Status)</span>
    </div>
    @if (Model.Actor.IsLocum)
    {
        <a class="btn btn-outline-primary" asp-action="Profile">Edit my profile</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-action="Index">Back to doctors</a>
    }
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Specialties</dt>
            <dd class="col-sm-9">@(locum.Specialties.Count == 0 ? "None listed" : string.Join(", ", locum.Specialties))</dd>
            <dt class="col-sm-3">Based in</dt>
            <dd class="col-sm-9">@locum.BaseLocation</dd>
            <dt class="col-sm-3">Minimum rate</dt>
            <dd class="col-sm-9">@UiHelpers.Money(locum.MinRatePerHour) per hour</dd>
            <dt class="col-sm-3">Experience</dt>
            <dd class="col-sm-9">@locum.YearsExperience years</dd>
            @if (locum.GmcNumber is not null)
            {
                <dt class="col-sm-3">GMC number</dt>
                <dd class="col-sm-9">@locum.GmcNumber <span class="text-muted">· check it on the public GMC register before the shift</span></dd>
            }
            @if (locum.Email is not null)
            {
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@locum.Email</dd>
            }
        </dl>
    </div>
</div>
