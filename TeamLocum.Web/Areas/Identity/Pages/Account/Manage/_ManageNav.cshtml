@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string Active(string page) => string.Equals(current, page, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<ul class="nav nav-pills flex-column">
    <li class="nav-item"><a class="nav-link @Active("/Account/Manage/Index")" id="profile" asp-page="./Index">Profile</a></li>
    <li class="nav-item"><a class="nav-link @Active("/Account/Manage/ChangePassword")" id="change-password" asp-page="./ChangePassword">Password</a></li>
</ul>
